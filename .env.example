POSTGRES_PASSWORD=changeme

# Must be base64url-encoded (no padding) — shared as-is between the Go
# backend (decodes it for HS256 signing) and PowerSync's client_auth JWK.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=changeme

POWERSYNC_DB_PASSWORD=changeme

# The externally-reachable PowerSync URL, handed to clients during
# pairing (see backend/internal/httpapi/pairing.go) so they don't have
# to enter it manually. For local dev, use your machine's LAN IP (e.g.
# http://192.168.1.50:8081) rather than localhost/10.0.2.2, so desktop,
# emulator, and physical-device clients can all pair against the same
# running backend at once.
POWERSYNC_PUBLIC_URL=changeme

# The externally-reachable backend URL. Optional — if unset,
# `bootstrap-pairing` still prints a QR code, just without the server URL
# baked in, so it has to be typed by hand during pairing.
PUBLIC_URL=

# Auth for PowerSync's own admin API (unrelated to client_auth /
# JWT_SECRET above). Any random string.
POWERSYNC_ADMIN_TOKEN=changeme

# Only used by docker-compose.prod.example.yml. The Docker network your
# reverse proxy's containers are on — find it with `docker network ls` on
# the deploy machine, do not guess this value. Not needed for local dev.
NPM_NETWORK_NAME=CHANGEME_fill_in_actual_npm_network_name

# Only used by docker-compose.prod.example.yml, to pick which published
# backend image tag to run.
IMAGE_TAG=latest
