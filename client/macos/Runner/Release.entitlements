<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: this ships as a plain unsigned .dmg, not through
	     the Mac App Store, so sandboxing only adds entitlement/Team-ID
	     coupling (e.g. keychain-access-groups) with no benefit. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
